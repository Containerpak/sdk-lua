{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Lua SDK",
  "description": "Lua interpreter, compiler and development headers.",
  "version": "5.4.8",
  "image": "ghcr.io/containerpak/sdk-lua@sha256:01fffafdc4fd5f5d84cb889916f57a6d50f63ca2f06085cfdbd18e8823db40b9",
  "binaries": [
    "/usr/bin/lua",
    "/usr/bin/luac",
    "/usr/bin/lua5.4",
    "/usr/bin/luac5.4"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "addon_provider": {
    "id": "lua",
    "slot": "sdk.lua",
    "mode": "exclusive",
    "exports": {
      "path": [
        "/usr/bin"
      ]
    }
  },
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "bluetooth": false,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "hostNetwork": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
